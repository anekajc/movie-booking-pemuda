# PostgreSQL connection string
# Local:   postgres://postgres:dev@localhost:5432/movie_order
# Coolify: use the "Postgres URL (internal)" from your Coolify database resource
DATABASE_URL=postgres://postgres:dev@localhost:5432/movie_order

# Password to enter /admin
ADMIN_PASSWORD=change-me

# Random secret used to sign the admin login cookie (32+ characters)
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# Optional: public base URL used in ticket QR codes and WhatsApp links.
# Leave unset to use the domain the request came in on (correct behind Coolify).
# APP_URL=https://nonton.yourdomain.org
